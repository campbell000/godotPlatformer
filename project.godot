[internationalization]

locale/translations_pot_files=PackedStringArray("res://asset_files/dialog/test.dialogue", "res://asset_files/dialog/laser.dialogue", "res://asset_files/dialog/test2.dialogue", "res://asset_files/dialog/firstComputer.dialogue", "res://asset_files/dialog/longText.dialogue", "res://asset_files/dialog/firstChipDestroyed.dialogue")

[network]

limits/debugger/max_chars_per_second=10000
limits/debugger/max_queued_messages=1000

[physics]

2d/run_on_separate_thread=false
2d/physics_engine="GodotPhysics2D"
2d/default_gravity=1000.0
2d/default_gravity_vector=Vector2(0, 1000)
common/enable_pause_aware_picking=true
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/screen_space_roughness_limiter/enabled=false
environment/defaults/default_environment="res://default_env.tres"
2d/snapping/use_gpu_pixel_snap=true
