; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Platformer Godot"
run/main_scene="res://levels/DemoLevel.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Globals="*res://objects/Globals.gd"
Physics="*res://objects/Physics.gd"
Common="*res://characters/player/States/Common.gd"
DialogueManager="*uid://dirn4lfoka2nf"
EventBus="*res://objects/EventBus.gd"
Dialog="*res://objects/Dialog.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

